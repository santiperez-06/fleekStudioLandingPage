# FLEEK studio — Variables de entorno requeridas
# Copiar este archivo como .env y completar los valores.

# Servidor
PORT=3000
NODE_ENV=production

# Admin — generar hash con: node scripts/setup.js
ADMIN_USER=
ADMIN_PASS_HASH=

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h

# Email (Resend — resend.com)
RESEND_API_KEY=
CONTACT_EMAIL=

# CORS — dominio(s) permitido(s) en produccion, separados por coma
ALLOWED_ORIGIN=https://tu-dominio.com
